# Sanity Project Settings (आपके sanity.io/manage डैशबोर्ड से लिए गए)
NEXT_PUBLIC_SANITY_PROJECT_ID=vfq6y7fb
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API Token — यह आपको खुद बनाना होगा (नीचे README में तरीका है)
SANITY_API_TOKEN=your_sanity_token

# Webhook Revalidation Secret (कोई भी लंबा random string बना लें, जैसे: sarkaripatrika_secret_2026_xyz)
SANITY_REVALIDATE_SECRET=your_random_secret_string

# साइट का लाइव डोमेन
NEXT_PUBLIC_SITE_URL=https://officialsarkaripatrika.com

# Google Analytics 4 - Measurement ID (जैसे G-XXXXXXXXXX)
# analytics.google.com से Property बनाकर यहाँ ID डालें
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense अप्रूवल मिलने के बाद यहाँ अपना Publisher/Client ID डालें (वैकल्पिक)
# जैसे: ca-pub-1234567890123456
# ⚠️ अब यह Sanity Studio → "⚙️ Website Settings" → "💰 AdSense" से भी डाला जा सकता है -
# वहाँ से डाला हुआ ID हमेशा प्राथमिकता में रहता है, इसलिए फोन से भी बदलना आसान है।
# जब तक कहीं से भी नहीं भरेंगे, Ads Script लोड ही नहीं होगी - कोई नुकसान नहीं।
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# 👉 ध्यान दें: Site Logo, Favicon, Google Search Console Verification Code,
# Bing Verification Code और Social Media Links — यह सब अब env variable में नहीं,
# बल्कि सीधे Sanity Studio → "⚙️ Website Settings" में जाकर भरे जाते हैं,
# ताकि फोन से भी बिना कोड छुए, कभी भी बदले जा सकें।

# Google Indexing API - नई पोस्ट को तुरंत Google को बताने के लिए (वैकल्पिक)
# Google Cloud Console से Service Account बनाकर यहाँ डालें
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=

# IndexNow - नई पोस्ट को तुरंत Bing और Yandex को बताने के लिए (वैकल्पिक, Google से अलग)
# कोई भी 32 अक्षर का random string बना लें (जैसे: https://www.uuidgenerator.net/ से एक UUID बिना डैश के)
# उदाहरण: a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
INDEXNOW_KEY=

# 🤖 AI FAQ Assistant (Post पर "AI से पूछें" वाला Feature) - Google AI Studio
# (aistudio.google.com) से मुफ़्त में एक API Key बनाई जा सकती है
GEMINI_API_KEY=

# 🔔 Push Notification (Standard Web Push - अब Firebase की कोई ज़रूरत नहीं)
# ------------------------------------------------------------------
# ये VAPID Keys खुद जनरेट करनी हैं (मुफ़्त, एक बार का काम)। टर्मिनल में यह चलाएँ:
#   npx web-push generate-vapid-keys
# इससे एक Public Key और एक Private Key मिलेगी - नीचे डाल दें।
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# कोई भी mailto: email (Push Service को बताने के लिए यह Notification किसने भेजी) - Secret नहीं है
VAPID_SUBJECT=mailto:your-email@example.com

# Cron Job Security - Vercel Cron को खुद पहचानने के लिए कोई भी random string बना लें
# (यह सुनिश्चित करता है कि /api/cron/retry-indexing को सिर्फ़ Vercel ही चला सके, कोई और नहीं)
CRON_SECRET=
